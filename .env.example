# Copy to .env.local. Generate a random secret: openssl rand -hex 32
# Required only until the first administrator is created using /login.
LMS_SETUP_TOKEN=
# Persistent path on a Node server (mount this directory as a durable volume).
LMS_DATABASE_PATH=.data/lms.sqlite
# Production origin is required; e.g. https://academy.example.com
LMS_ORIGIN=http://localhost:3000
# Optional: a Resend (https://resend.com) API key. When unset, verification and password-reset
# emails are logged to the console instead of being sent — useful for local development.
LMS_EMAIL_API_KEY=
# Sender identity used for outgoing email, e.g. "Tekskillup Academy <no-reply@yourdomain.com>".
LMS_EMAIL_FROM=
# Stripe Billing. Create two recurring Prices (monthly/yearly) and point a webhook at /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Optional when the Stripe account's default customer portal configuration is enabled.
STRIPE_PORTAL_CONFIGURATION_ID=
